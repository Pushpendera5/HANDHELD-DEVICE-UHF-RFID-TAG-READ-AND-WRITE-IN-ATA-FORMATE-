<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/epcRowEpcText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        style="@style/TextAppearance.Rfid.BodyText"
        tools:text="EPC" />

    <TextView
        android:id="@+id/epcRowStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        style="@style/TextAppearance.Rfid.HelperMetaText"
        tools:text="FOUND" />

    <ImageButton
        android:id="@+id/epcRowCopyButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Copy EPC"
        android:padding="8dp"
        android:src="@drawable/ic_copy_24"
        android:tint="?attr/colorOnSurface" />
</LinearLayout>

