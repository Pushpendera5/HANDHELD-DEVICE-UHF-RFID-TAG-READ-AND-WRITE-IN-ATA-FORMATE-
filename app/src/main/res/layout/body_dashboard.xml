<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/rfid_card_spacing"
        app:cardCornerRadius="@dimen/rfid_radius_large"
        app:cardBackgroundColor="@color/rfid_card_surface"
        app:cardElevation="2dp"
        app:strokeColor="@color/rfid_card_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/rfid_screen_padding">

        <TextView
            android:id="@+id/dashboardProviderStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.Rfid.SectionTitle"
            android:text="Connected provider"
            />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/TextAppearance.Rfid.HelperMetaText"
            android:text="Open the task you need most often from here."
            android:layout_marginTop="10dp" />

        <LinearLayout
            android:id="@+id/dashboardFeatureList"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>
</ScrollView>

