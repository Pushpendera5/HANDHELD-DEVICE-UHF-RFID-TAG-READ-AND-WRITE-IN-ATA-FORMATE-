<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dashboardActionCardRoot"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:minHeight="88dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/rfid_radius_large"
    app:cardBackgroundColor="@color/rfid_card_surface"
    app:cardElevation="2dp"
    app:strokeColor="@color/rfid_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dashboardActionIconContainer"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_vertical"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="@color/rfid_chip_background"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/dashboardActionIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:padding="0dp"
                android:src="@android:drawable/ic_menu_info_details"
                android:tint="?attr/colorPrimary" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/dashboardActionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.Rfid.ActionTitle"
                android:text="Action Title" />

            <TextView
                android:id="@+id/dashboardActionSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.Rfid.HelperMetaText"
                android:text="Short description"
                android:layout_marginTop="6dp"
                android:maxLines="2"
                android:ellipsize="end" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

