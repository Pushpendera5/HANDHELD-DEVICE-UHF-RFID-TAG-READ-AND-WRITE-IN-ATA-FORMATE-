<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- OpenRFID Suite Container (Triple tap reveals Zebra RFID connector) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOpenRfidSuite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="@color/rfid_card_surface"
            app:cardElevation="2dp"
            app:strokeColor="@color/rfid_card_stroke"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/app_logo"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/app_name" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OpenRFID Suite"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/rfid_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Handheld RFID Terminal"
                        android:textSize="12sp"
                        android:alpha="0.7"
                        android:textColor="@color/rfid_on_surface" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Section Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="4dp"
            style="@style/TextAppearance.Rfid.SectionTitle"
            android:text="RFID Operations" />

        <!-- Operations Grid (2 columns) -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:alignmentMode="alignMargins">

            <!-- Read Tag Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnQuickReadTag"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/rfid_card_surface"
                app:cardElevation="2dp"
                app:strokeColor="@color/rfid_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:background="@drawable/bg_icon_badge">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_card_read"
                            app:tint="@color/rfid_primary"
                            android:contentDescription="Read" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Read Tag"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/rfid_on_surface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Scan EPC &amp; continuous read"
                        android:textSize="12sp"
                        android:alpha="0.7"
                        android:textColor="@color/rfid_on_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Write Tag Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnQuickWriteTag"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/rfid_card_surface"
                app:cardElevation="2dp"
                app:strokeColor="@color/rfid_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:background="@drawable/bg_icon_badge">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_card_write"
                            app:tint="@color/rfid_primary"
                            android:contentDescription="Write" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Write Tag"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/rfid_on_surface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Write EPC &amp; user memory"
                        android:textSize="12sp"
                        android:alpha="0.7"
                        android:textColor="@color/rfid_on_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tag Lock Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnQuickTagLock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/rfid_card_surface"
                app:cardElevation="2dp"
                app:strokeColor="@color/rfid_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:background="@drawable/bg_icon_badge">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_card_lock"
                            app:tint="@color/rfid_primary"
                            android:contentDescription="Lock" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Tag Security"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/rfid_on_surface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Lock memory &amp; passwords"
                        android:textSize="12sp"
                        android:alpha="0.7"
                        android:textColor="@color/rfid_on_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Hardware Diagnostics Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnQuickDiagnostics"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="5dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/rfid_card_surface"
                app:cardElevation="2dp"
                app:strokeColor="@color/rfid_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:gravity="center"
                        android:background="@drawable/bg_icon_badge">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_card_diagnostics"
                            app:tint="@color/rfid_primary"
                            android:contentDescription="Diagnostics" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Diagnostics"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/rfid_on_surface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Hardware logs &amp; self-test"
                        android:textSize="12sp"
                        android:alpha="0.7"
                        android:textColor="@color/rfid_on_surface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>



        <!-- Powered by signature -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text="Powered and Developed by Way Infotech Solutions"
            android:textSize="11sp"
            android:alpha="0.5"
            android:textColor="@color/rfid_on_surface" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
