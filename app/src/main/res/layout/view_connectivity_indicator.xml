<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/connectivityIndicatorRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardCornerRadius="@dimen/rfid_radius_small"
    app:cardBackgroundColor="@color/rfid_card_surface"
    app:cardElevation="1dp"
    app:strokeColor="@color/rfid_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <View
            android:id="@+id/connectivityIndicatorDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="6dp"
            android:background="@color/rfid_offline" />

        <TextView
            android:id="@+id/connectivityIndicatorText"
            style="@style/TextAppearance.Rfid.HelperMetaText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_offline" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

