<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/epcRowRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/rfid_list_item_spacing"
    android:layout_marginBottom="@dimen/rfid_list_item_spacing"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="@dimen/rfid_radius_small"
    app:cardBackgroundColor="@color/rfid_card_surface"
    app:cardElevation="0dp"
    app:strokeColor="@color/rfid_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/rfid_screen_padding">

        <View
            android:id="@+id/epcAvailabilityDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="center_vertical"
            android:background="@color/rfid_card_stroke" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/epcValueText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.Rfid.BodyText"
                tools:text="EPC_VALUE"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/epcStateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextAppearance.Rfid.HelperMetaText"
                tools:text="state=active"
                android:layout_marginTop="6dp" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

