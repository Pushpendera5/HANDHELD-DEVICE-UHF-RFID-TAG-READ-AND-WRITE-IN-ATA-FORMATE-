<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/rfid_screen_padding">

    <TextView
        android:id="@+id/uhfConfigTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.Rfid.SectionTitle"
        android:text="Reader Settings" />

    <TextView
        android:id="@+id/uhfConfigSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/uhfDriverInputLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:hint="Hardware Driver">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/uhfDriverSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/uhfPowerInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Antenna Power (dBm)"
        android:layout_marginTop="@dimen/rfid_section_spacing">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/uhfPowerInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/uhfRegionInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rfid_section_spacing"
        android:hint="Region (Optional)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/uhfRegionInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/uhfSoundSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rfid_section_spacing"
        android:text="Sound Feedback"
        android:checked="true"
        style="@style/TextAppearance.Rfid.SectionTitle" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/uhfSaveApplyButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/rfid_section_spacing"
        android:text="Save Settings" />

    <TextView
        android:id="@+id/uhfConfigStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/TextAppearance.Rfid.HelperMetaText"
        android:text="—"
        android:layout_marginTop="12dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
